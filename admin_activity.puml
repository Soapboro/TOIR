@startuml
title Диаграмма деятельности администратора системы ТОИР

start

:Открыть систему ТОИР;
:Ввести email и пароль;

if (Учетные данные верны?) then (да)
  :Открыть административный дашборд;
else (нет)
  :Показать ошибку авторизации;
  stop
endif

repeat
  :Выбрать раздел системы;

  if (Раздел "Пользователи"?) then (да)
    :Просмотреть список пользователей;
    if (Нужно создать пользователя?) then (да)
      :Заполнить email, логин, пароль, роль и профиль;
      :Создать пользователя;
    elseif (Нужно изменить пользователя?) then (да)
      :Открыть карточку пользователя;
      :Изменить роль, активность или профиль;
      :Сохранить изменения;
    elseif (Нужно удалить пользователя?) then (да)
      if (Это собственный аккаунт?) then (да)
        :Запретить удаление;
      else (нет)
        :Подтвердить удаление;
        :Удалить пользователя;
      endif
    else (нет)
      :Вернуться к списку пользователей;
    endif

  elseif (Раздел "Оборудование"?) then (да)
    :Просмотреть оборудование и статусы;
    if (Нужно создать оборудование?) then (да)
      :Заполнить карточку оборудования;
      :Создать оборудование;
    elseif (Нужно изменить оборудование?) then (да)
      :Открыть карточку оборудования;
      :Изменить параметры или статус;
      :Сохранить изменения;
    elseif (Нужно удалить оборудование?) then (да)
      :Подтвердить удаление;
      :Удалить оборудование;
    else (нет)
      :Отфильтровать или найти оборудование;
    endif

  elseif (Раздел "Заявки"?) then (да)
    :Просмотреть ремонтные заявки;
    if (Есть новая заявка без исполнителя?) then (да)
      :Выбрать исполнителя;
      :Назначить заявку;
    elseif (Нужно изменить статус заявки?) then (да)
      :Открыть заявку;
      :Выбрать допустимый статус;
      :Сохранить статус;
    else (нет)
      :Контролировать ход выполнения;
    endif

  elseif (Раздел "ТО"?) then (да)
    :Просмотреть планы и календарь ТО;
    if (Нужно зафиксировать выполнение?) then (да)
      :Заполнить фактические работы, дату и трудоемкость;
      :Сохранить запись о выполнении;
    else (нет)
      :Контролировать просроченные и запланированные работы;
      :При необходимости передать планирование менеджеру;
    endif

  elseif (Раздел "Аналитика / дашборд"?) then (да)
    :Просмотреть статистику оборудования;
    :Просмотреть открытые заявки;
    :Просмотреть план-факт ТО;
    :Оценить просроченные работы и риски;

  else (другое)
    :Вернуться на дашборд;
  endif

repeat while (Администратор продолжает работу?) is (да)

:Выйти из системы;
stop

@enduml
