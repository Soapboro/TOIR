# ══════════════════════════════════════════════════════════════════════════════
#  ТОИР — Production Environment Variables
#  Скопируйте файл в .env.prod и заполните значения:
#    cp .env.prod.example .env.prod
# ══════════════════════════════════════════════════════════════════════════════

# ── Домен ─────────────────────────────────────────────────────────────────────
# Имя домена без схемы и слэша (используется nginx и Django)
DOMAIN_NAME=your-domain.com

# ── Django Security ───────────────────────────────────────────────────────────
# Сгенерируйте командой:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-50-char-random-string

DEBUG=False

# Через запятую, без пробелов
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Для Django admin CSRF и HTTPS cookies
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ── База данных ───────────────────────────────────────────────────────────────
DB_NAME=toir_db
DB_USER=toir_user
# Используйте надёжный пароль (мин. 20 символов, буквы+цифры+спецсимволы)
DB_PASSWORD=change-me-strong-db-password
DB_HOST=db
DB_PORT=5432

# Для контейнера postgres (должны совпадать с DB_* выше)
POSTGRES_DB=toir_db
POSTGRES_USER=toir_user
POSTGRES_PASSWORD=change-me-strong-db-password

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Gunicorn tuning (опционально) ─────────────────────────────────────────────
# Рекомендуется: (2 × кол-во CPU) + 1
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
# Для Gmail: https://support.google.com/accounts/answer/185833
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=ТОИР <your-email@gmail.com>
