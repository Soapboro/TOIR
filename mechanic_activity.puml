@startuml
start

:Открыть систему ТОИР;
:Ввести email и пароль;

if (Учетные данные верны?) then (да)
  :Открыть дашборд механика;
else (нет)
  :Показать ошибку авторизации;
  stop
endif

repeat
  :Выбрать раздел системы;

  if (Раздел "Дашборд"?) then (да)
    :Просмотреть назначенные заявки;
    :Просмотреть свободные новые заявки;
    :Просмотреть назначенные работы ТО;
    :Оценить просроченные работы ТО;

  elseif (Раздел "Заявки"?) then (да)
    :Просмотреть доступные заявки;

    if (Есть свободная новая заявка?) then (да)
      :Открыть заявку;
      if (Заявка никем не занята?) then (да)
        :Взять заявку в работу;
      else (нет)
        :Показать, что заявка уже назначена;
      endif
    endif

    if (Есть назначенная заявка?) then (да)
      :Открыть назначенную заявку;
      :Изучить описание неисправности и оборудование;
      :Выполнить ремонтные работы;

      if (Работы завершены?) then (да)
        :Указать выполненные работы;
        :Перевести заявку в статус "Выполнена";
      elseif (Работы нужно приостановить?) then (да)
        :Перевести заявку в статус "Приостановлена";
      else (нет)
        :Оставить заявку в работе;
      endif
    else (нет)
      :Ожидать назначения или свободных заявок;
    endif

  elseif (Раздел "ТО"?) then (да)
    :Просмотреть планы и календарь ТО;
    :Найти назначенные работы ТО;

    if (Есть назначенная работа ТО?) then (да)
      :Открыть план ТО;
      :Выполнить обслуживание оборудования;
      :Заполнить дату, трудоемкость и описание работ;
      :Указать замененные детали и дату следующего ТО;
      :Сохранить запись о выполнении;
      :План ТО получает статус "Выполнено";
    else (нет)
      :Просмотреть ближайшие и просроченные работы;
    endif

  elseif (Раздел "Уведомления"?) then (да)
    :Просмотреть уведомления о назначениях и изменениях статусов;
    :Открыть связанную заявку или работу ТО;

  else (другое)
    :Вернуться на дашборд;
  endif

repeat while (Механик продолжает работу?) is (да)

:Выйти из системы;
stop

@enduml
