# ══════════════════════════════════════════════════════════════════════════════
# ТОИР — nginx reverse proxy
# Переменная ${DOMAIN_NAME} подставляется через envsubst при старте контейнера.
# ══════════════════════════════════════════════════════════════════════════════

# ── Upstream сервисы ──────────────────────────────────────────────────────────
upstream backend {
    server backend:8000;
    keepalive 32;
}

upstream frontend {
    server frontend:80;
    keepalive 16;
}

# ── HTTP → HTTPS redirect + ACME challenge ───────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN_NAME} www.${DOMAIN_NAME};

    # Let's Encrypt webroot challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }

    # Health check (без редиректа, чтобы мониторинг работал по HTTP)
    location = /health {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS ─────────────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN_NAME} www.${DOMAIN_NAME};

    # ── Let's Encrypt сертификаты ─────────────────────────────────────────────
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;
    include             /etc/nginx/snippets/ssl-params.conf;

    # ── Логи ──────────────────────────────────────────────────────────────────
    access_log /var/log/nginx/toir_access.log combined;
    error_log  /var/log/nginx/toir_error.log warn;

    # ── Размер загружаемых файлов ─────────────────────────────────────────────
    client_max_body_size 50M;

    # ── Таймауты proxy ────────────────────────────────────────────────────────
    proxy_connect_timeout 10s;
    proxy_send_timeout    90s;
    proxy_read_timeout    90s;

    # Общие заголовки для всех proxy-блоков
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;

    # ── Django Admin ──────────────────────────────────────────────────────────
    location /admin/ {
        proxy_pass http://backend;
        proxy_set_header Connection "";
    }

    # ── Django REST API ───────────────────────────────────────────────────────
    location /api/ {
        proxy_pass http://backend;
        proxy_set_header Connection "";

        # Отключаем буферизацию для SSE / streaming ответов
        proxy_buffering off;
    }

    # ── Django статика (collectstatic) ────────────────────────────────────────
    location /static/ {
        alias   /app/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        access_log off;

        # gzip для статики
        gzip_static on;
    }

    # ── Django медиафайлы ─────────────────────────────────────────────────────
    location /media/ {
        alias   /app/media/;
        expires 7d;
        add_header Cache-Control "public, no-transform";
        access_log off;
    }

    # ── Health check ──────────────────────────────────────────────────────────
    location = /health {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    # ── React SPA (всё остальное → frontend) ─────────────────────────────────
    location / {
        proxy_pass http://frontend;
        proxy_set_header Connection "";
    }
}
