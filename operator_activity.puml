@startuml
title Диаграмма деятельности оператора системы ТОИР

start

:Открыть систему ТОИР;
:Ввести email и пароль;

if (Учетные данные верны?) then (да)
  :Открыть дашборд оператора;
else (нет)
  :Показать ошибку авторизации;
  stop
endif

repeat
  :Выбрать раздел системы;

  if (Раздел "Дашборд"?) then (да)
    :Просмотреть свои открытые заявки;
    :Просмотреть общую статистику по оборудованию;
    :Проверить просроченные или критичные работы;

  elseif (Раздел "Оборудование"?) then (да)
    :Просмотреть список оборудования;
    :Проверить статус оборудования;
    :Найти оборудование по названию, номеру или расположению;

    if (Обнаружена неисправность?) then (да)
      :Перейти к созданию заявки;
    else (нет)
      :Продолжить просмотр оборудования;
    endif

  elseif (Раздел "Заявки"?) then (да)
    :Просмотреть свои заявки;

    if (Нужно создать заявку?) then (да)
      :Нажать "Новая заявка";
      :Выбрать оборудование;
      :Указать тему неисправности;
      :Описать проблему;
      :Выбрать приоритет;
      :Создать заявку;
    elseif (Нужно проверить статус заявки?) then (да)
      :Открыть свою заявку;
      :Просмотреть статус и исполнителя;
      :Просмотреть историю изменений;
    elseif (Нужно отменить новую заявку?) then (да)
      if (Заявка еще новая?) then (да)
        :Перевести заявку в статус "Отменена";
      else (нет)
        :Ожидать обработки исполнителем или менеджером;
      endif
    else (нет)
      :Вернуться к списку заявок;
    endif

  elseif (Раздел "ТО"?) then (да)
    :Просмотреть планы и календарь ТО;
    :Проверить ближайшие работы по оборудованию;

  elseif (Раздел "Уведомления"?) then (да)
    :Просмотреть уведомления по своим заявкам;
    :Открыть связанную заявку;
    :Проверить изменение статуса или назначение исполнителя;

  else (другое)
    :Вернуться на дашборд;
  endif

repeat while (Оператор продолжает работу?) is (да)

:Выйти из системы;
stop

@enduml
